{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8001",
  "Rp": {
    "PublicConfigFile": "rp_public.json"
    // RP private keys are a SECRET — never put them here. Provide one of:
    //   Rp:PrivateKeys      inline JSON via user-secrets / env Rp__PrivateKeys / Key Vault
    //   Rp:PrivateKeysFile  path to a mounted secret file
  },
  "Oidc": {
    // Production OpenID Providers, always shown. EntityId = federation entity id of each
    // IdP/OP. Replace with the real production federation entity ids before going live.
    "ProductionProviders": [
      { "Profile": "spid", "Name": "Aruba ID",       "EntityId": "https://loginspid.aruba.it/op" },
      { "Profile": "spid", "Name": "Poste ID",        "EntityId": "https://posteid.poste.it/op" },
      { "Profile": "spid", "Name": "TIM ID",          "EntityId": "https://login.id.tim.it/op" },
      { "Profile": "spid", "Name": "InfoCert ID",     "EntityId": "https://identity.infocert.it/op" },
      { "Profile": "spid", "Name": "Lepida ID",       "EntityId": "https://id.lepida.it/op" },
      { "Profile": "spid", "Name": "Namirial ID",     "EntityId": "https://idp.namirialtsp.com/op" },
      { "Profile": "spid", "Name": "Sielte ID",       "EntityId": "https://identity.sieltecloud.it/op" },
      { "Profile": "spid", "Name": "SPIDItalia",      "EntityId": "https://spid.register.it/op" },
      { "Profile": "spid", "Name": "Intesi Group",    "EntityId": "https://idp.intesigroup.com/op" },
      { "Profile": "spid", "Name": "TeamSystem ID",   "EntityId": "https://spid.teamsystem.com/op" },
      { "Profile": "cie",  "Name": "CIE id",          "EntityId": "https://idserver.servizicie.interno.gov.it/op" }
    ]
    // Local test providers are defined in appsettings.Development.json and shown only in Development.
  }
}
