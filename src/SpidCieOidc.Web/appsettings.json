{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8001",
  "Rp": {
    "PublicConfigFile": "rp_public.json"
    // RP private keys are a SECRET — never put them here. Provide one of:
    //   Rp:PrivateKeys      inline JSON via user-secrets / env Rp__PrivateKeys / Key Vault
    //   Rp:PrivateKeysFile  path to a mounted secret file
  },
  "Oidc": {
    "Providers": {
      "spid": "http://trust-anchor.org:8000/oidc/op",
      "cie": "http://cie-provider.org:8002/oidc/op"
    }
  }
}
