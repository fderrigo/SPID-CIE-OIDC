{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Rp": {
    // local `dotnet run`: read the gitignored demo key file at the repo root.
    // Path is relative to the content root (src/SpidCieOidc.Web). Not a secret (just a path).
    "PrivateKeysFile": "../../secrets/rp_private_keys.json"
  },
  "Oidc": {
    // Local test providers, shown ONLY in Development (in addition to production).
    "LocalProviders": [
      { "Profile": "spid", "Name": "SPID Locale (test)", "EntityId": "http://trust-anchor.org:8000/oidc/op" },
      { "Profile": "cie",  "Name": "CIE Locale (test)",  "EntityId": "http://cie-provider.org:8002/oidc/op" }
    ]
  }
}
